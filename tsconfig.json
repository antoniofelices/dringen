{
    "compilerOptions": {
        /* Vitest */
        "types": ["@vitest/browser/providers/playwright"],
        "paths": {
            "@/*": ["./src/*"],
            "@auth/*": ["./src/auth/*"],
            "@config/*": ["./src/config/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@resourcesmedplum/*": ["./src/medplum/*"],
            "@pages/*": ["./src/pages/*"],
            "@resources/*": ["./src/resources/*"],
            "@shared/*": ["./src/shared/*"],
            "@workflows/*": ["./src/workflows/*"]
        }
    },
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.node.json" }
    ]
}
